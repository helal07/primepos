APP_NAME="Prime POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://primepos.example.com
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=primepos
DB_USERNAME=primepos
DB_PASSWORD=change_me

BROADCAST_CONNECTION=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=primepos.example.com
SANCTUM_GUARD=web

# Frontend (Vite) ------------------------------------------------------------
VITE_BACKEND=laravel
VITE_API_BASE_URL=https://primepos.example.com

# Mail / SMTP ----------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateways -----------------------------------------------------------
BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

EPS_BASE_URL=
EPS_MERCHANT_ID=
EPS_API_KEY=

SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=false

# SMS Providers --------------------------------------------------------------
SMS_DEFAULT_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Backup ---------------------------------------------------------------------
BACKUP_DISK=private
BACKUP_RETENTION_DAYS=30

# Realtime (Laravel Reverb) --------------------------------------------------
REVERB_APP_ID=primepos
REVERB_APP_KEY=change_me_key
REVERB_APP_SECRET=change_me_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Public-facing (used by the SPA / Echo client)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=ws.primepos.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
# Horizontal scaling (multi-node Reverb). Set true when running more than one
# Reverb worker — events fan out across nodes via Redis pub/sub.
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SUPERADMIN_EMAIL=email2itsolution@gmail.com
SUPERADMIN_PASSWORD=IT121212@
SUPERADMIN_NAME="Super Admin"
